@model ClassFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit class" : "New class";
}

<div class="narrow">
    <a class="back" asp-action="Index">&larr; Back to classes</a>
    <h1>@ViewData["Title"]</h1>

    <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" class="form card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly"></div>

        <div class="field">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title"></span>
        </div>

        <div class="field">
            <label asp-for="Description"></label>
            <textarea asp-for="Description"></textarea>
            <span asp-validation-for="Description"></span>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="Category"></label>
                <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()">
                    <option value="">Choose a category</option>
                </select>
                <span asp-validation-for="Category"></span>
            </div>
            <div class="field">
                <label asp-for="InstructorId"></label>
                <select asp-for="InstructorId" asp-items="Model.Instructors">
                    <option value="">Choose an instructor</option>
                </select>
                <span asp-validation-for="InstructorId"></span>
            </div>
        </div>

        <div class="field-row">
            <div class="field">
                <label asp-for="StartTime"></label>
                <input asp-for="StartTime" />
                <span asp-validation-for="StartTime"></span>
                <p class="hint">Studio time (Central). @(isEdit ? "It can't change once anyone has booked." : "")</p>
            </div>
            <div class="field">
                <label asp-for="Capacity"></label>
                <input asp-for="Capacity" min="1" max="200" />
                <span asp-validation-for="Capacity"></span>
                @if (isEdit)
                {
                    <p class="hint">Can't go below the confirmed and offered bookings.</p>
                }
            </div>
        </div>

        <div class="actions">
            <button type="submit" class="btn">@(isEdit ? "Save changes" : "Create class")</button>
            <a class="btn btn-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
